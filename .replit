modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "King SMM"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "King SMM"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=25104 BASE_PATH=/ pnpm --filter @workspace/king-smm run dev"
waitForPort = 25104

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
FIREBASE_APP_ID = "1:767088510240:web:e2d7cd97c2dfc58dc30345"
FIREBASE_AUTH_DOMAIN = "kingsmm-dab0e.firebaseapp.com"
FIREBASE_MEASUREMENT_ID = "G-TLFERNQ6MK"
FIREBASE_MESSAGING_SENDER_ID = "767088510240"
FIREBASE_PROJECT_ID = "kingsmm-dab0e"
FIREBASE_STORAGE_BUCKET = "kingsmm-dab0e.firebasestorage.app"
